{
	"name": "es5-ext",
	"version": "0.10.64",
	"description": "ECMAScript extensions and shims",
	"author": "Mariusz Nowak <medyk@medikoo.com> (http://www.medikoo.com/)",
	"keywords": [
		"ecmascript",
		"ecmascript5",
		"ecmascript6",
		"es5",
		"es6",
		"extensions",
		"ext",
		"addons",
		"extras",
		"harmony",
		"javascript",
		"polyfill",
		"shim",
		"util",
		"utils",
		"utilities"
	],
	"repository": "medikoo/es5-ext",
	"dependencies": {
		"es6-iterator": "2.0.3",
		"es6-symbol": "3.1.4",
		"esniff": "2.0.1",
		"next-tick": "1.1.0"
	},
	"devDependencies": {
		"eslint": "8.57.1",
		"eslint-config-medikoo": "5.2.0",
		"git-list-updated": "1.2.1",
		"github-release-from-cc-changelog": "2.3.0",
		"husky": "4.3.8",
		"lint-staged": "13.3.0",
		"minimist": "1.2.8",
		"nyc": "18.0.0",
		"plain-promise": "0.1.1",
		"prettier-elastic": "3.2.5",
		"tad": "3.1.1"
	},
	"husky": {
		"hooks": {
			"pre-commit": "lint-staged"
		}
	},
	"lint-staged": {
		"*.js": [
			"eslint"
		],
		"*.{css,html,js,json,md,yaml,yml}": [
			"prettier -c"
		]
	},
	"eslintConfig": {
		"extends": "medikoo/es5",
		"root": true,
		"rules": {
			"no-extend-native": "off"
		},
		"overrides": [
			{
				"files": "global.js",
				"globals": {
					"__global__": true,
					"globalThis": true,
					"self": true,
					"window": true
				},
				"rules": {
					"strict": "off"
				}
			}
		]
	},
	"prettier": {
		"printWidth": 100,
		"tabWidth": 4,
		"overrides": [
			{
				"files": [
					"*.md",
					"*.yml"
				],
				"options": {
					"tabWidth": 2
				}
			}
		]
	},
	"nyc": {
		"all": true,
		"exclude": [
			".github",
			"coverage/**",
			"test/**",
			"*.config.js"
		],
		"reporter": [
			"lcov",
			"html",
			"text-summary"
		]
	},
	"scripts": {
		"install": "npm install --ignore-scripts",
		"coverage": "nyc npm test",
		"lint": "eslint --ignore-path=.gitignore .",
		"lint:updated": "pipe-git-updated --base=main --ext=js -- eslint --ignore-pattern '!*'",
		"prettier-check": "prettier -c --ignore-path .gitignore \"**/*.{css,html,js,json,md,yaml,yml}\"",
		"prettier-check:updated": "pipe-git-updated --base=main --ext=css --ext=html --ext=js --ext=json --ext=md --ext=yaml --ext=yml -- prettier -c",
		"prettify": "prettier --write --ignore-path .gitignore \"**/*.{css,html,js,json,md,yaml,yml}\"",
		"prettify:updated": "pipe-git-updated ---base=main -ext=css --ext=html --ext=js --ext=json --ext=md --ext=yaml --ext=yml -- prettier --write",
		"test": "node ./node_modules/tad/bin/tad"
	},
	"engines": {
		"node": ">=0.10"
	},
	"license": "ISC",
	"overrides": {
		"es6-iterator": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"sprintf-kit": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"d": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"cli-progress-footer": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"es6-set": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"stream-promise": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"plain-promise": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"es6-weak-map": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"tad": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64",
			"cli-color": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			}
		},
		"cli-color": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"memoizee": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"deferred": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"log": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"2-thenable": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"duration": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"event-emitter": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"git-list-updated": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"child-process-ext": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"esniff": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"next": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64",
			"es6-iterator": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			},
			"d": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			},
			"es6-symbol": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			},
			"es6-weak-map": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			},
			"memoizee": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			}
		},
		"es6-symbol": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"find-requires": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64",
			"esniff": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			}
		},
		"timers-ext": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"lru-queue": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"ncjsm": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64",
			"fs2": {
				"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
			}
		},
		"fs2": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"es5-ext": {
			"es5-ext": "github:fdpamb/es5-ext#patch-upgrade-0.10.64"
		},
		"optimist": {
			"minimist": "1.2.8"
		}
	}
}
